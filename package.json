{
  "name": "connaissances-univers",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "contenu": "node scripts/contenu.mjs",
    "contenu:watch": "node scripts/contenu.mjs --watch",
    "prestart": "npm run contenu",
    "start": "concurrently -k -n contenu,ng -c yellow,blue \"npm:contenu:watch\" \"ng serve\"",
    "prebuild": "npm run contenu",
    "build": "ng build",
    "pretest": "npm run contenu",
    "test": "ng test --watch=false && npm run test:contenu",
    "test:contenu": "vitest run --config scripts/vitest.config.mjs",
    "test:watch": "ng test",
    "serve:ssr": "node dist/connaissances-univers/server/server.mjs",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\" \"scripts/**/*.mjs\"",
    "docker:build": "docker buildx build --push --platform linux/amd64,linux/arm64 --tag ccmlits/connaissances-univers:$npm_package_version ."
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "@angular/ssr": "^22.2.4",
    "@ng-bootstrap/ng-bootstrap": "^21.0.0",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/localize": "^22.2.3",
    "@types/express": "^5.0.1",
    "@types/node": "^22.12.0",
    "concurrently": "^10.0.6",
    "gray-matter": "^4.0.3",
    "hast-util-to-string": "^3.0.1",
    "hastscript": "^9.0.1",
    "jsdom": "^30.0.0",
    "mdast-util-to-string": "^4.0.0",
    "prettier": "^3.8.1",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "~6.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.22.3"
  }
}
